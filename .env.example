APP_ENV=local
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://booking:CHANGE_ME@127.0.0.1:55432/booking
MIGRATION_DATABASE_URL=postgres://booking:CHANGE_ME@127.0.0.1:55432/booking
SESSION_SECRET=GENERATE_A_RANDOM_64_HEX_CHARACTER_VALUE
RUN_JOBS=true
# Supabase is required only for APP_ENV=production (never deploy local auth).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_ID=
# 공공데이터포털 한국천문연구원_특일 정보 활용신청 후 받은 서비스키.
# 서버 전용. NEXT_PUBLIC_ 접두사를 사용하지 마세요. 인코딩/디코딩 키 모두 지원합니다.
HOLIDAY_API_KEY=

# Slack web handoff: same origin in bot and web processes; HTTPS in production.
SLACK_WEB_BASE_URL=
SLACK_ALLOWED_WORKSPACE_IDS=
SLACK_TOKEN_ENCRYPTION_KEY=

# SaaS: unrestricted launch is gated; existing-customer rollout uses release mode pilot.
SAAS_ENABLED=false
SAAS_RELEASE_MODE=
# Separate non-privileged identity/routing role (never a migration role).
CONTROL_DATABASE_URL=
# Metadata-only notification scheduler role.
WORKER_DATABASE_URL=
# Remains blocked until independent deletion ledger and <=30-day backup retention are verified.
SAAS_DELETION_ENABLED=false

# Copy local DB, URL, and workspace settings from .env.lan.local.
APP_ENV=local
APP_BASE_URL=http://192.168.10.64:3002
DATABASE_URL=
SLACK_WORKSPACE_ID=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_APP_ENABLED=false
RUN_JOBS=false
# Only list workspaces sharing this deployment's rooms and registered members.
SLACK_ALLOWED_WORKSPACE_IDS=
SLACK_APP_ID=
# 64 hex characters. Share the same key with the web OAuth process.
SLACK_TOKEN_ENCRYPTION_KEY=
# Web process only. Keep installation disabled until HTTPS is configured.
SLACK_INSTALL_ENABLED=false
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SESSION_SECRET=
